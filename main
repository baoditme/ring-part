minBtn.MouseButton1Click:Connect(function()
    tween(Main, ANIM_SPRING, { Size = UDim2.new(0, 380, 0, 0) })
    task.wait(0.35); Main.Visible = false; reopenBtn.Visible = true
end)

reopenBtn.MouseButton1Click:Connect(function()
    Main.Visible = true; Main.Size = UDim2.new(0, 380, 0, 0)
    tween(Main, ANIM_SPRING, { Size = UDim2.new(0, 380, 0, 700) })
    reopenBtn.Visible = false
end)

closeBtn.MouseButton1Click:Connect(function()
    stopMode()
    tween(Main, ANIM_FAST, { Size = UDim2.new(0, 380, 0, 0) })
    task.wait(0.2)
    Gui:Destroy()
end)

Main.Size = UDim2.new(0, 380, 0, 0)
task.wait(0.05)
tween(Main, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
    Size = UDim2.new(0, 380, 0, 700)
})

print("[Bring Vortex v5.5] Full Edition Loaded Successfully.")
