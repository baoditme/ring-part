-- ============================================================
--  VORTEX OFFSETS
-- ============================================================
local VORTEX_OFFSETS = {}
local function buildVortexOffsets()
    local offs = {}
    local S, N = SPACING, SEGMENTS
    for arm = 1, 4 do
        local baseAngle = (arm - 1) * (math.pi / 2)
        for i = 1, N do
            local dist = i * S
            local angle = baseAngle + (i * 0.12)
            table.insert(offs, Vector2.new(math.cos(angle) * dist, math.sin(angle) * dist))
        end
    end
    return offs
end
VORTEX_OFFSETS = buildVortexOffsets()

-- ============================================================
--  SAVE / LOAD
-- ============================================================
local SAVE_KEY = "BringVortexConfig_v52"

local function saveConfig()
    pcall(function()
        if not writefile then return end
        writefile(SAVE_KEY .. ".json", HttpService:JSONEncode({
            segments = SEGMENTS, spacing = SPACING, maxVel = MAX_VEL,
            spinSpeed = SPIN_SPEED, orientation = orientation, rotated45 = rotated45,
            partSpin = partSpin, showPreview = showPreview,
            bringKey = bringKey and bringKey.Name or nil, customGrid = customGrid,
            tornadoRings = TORNADO_RINGS, tornadoPerRing = TORNADO_PER_RING,
            tornadoHeight = TORNADO_HEIGHT, tornadoTopR = TORNADO_TOP_RADIUS,
            tornadoBotR = TORNADO_BOT_RADIUS, tornadoSpin = TORNADO_SPIN_SPEED,
            ringRadius = RING_RADIUS, ringPoints = RING_POINTS,
            ringSpin = RING_SPIN_SPEED, ringHeight = RING_HEIGHT,
            sphereRadius = SPHERE_RADIUS, sphereRings = SPHERE_RINGS,
            spherePerRing = SPHERE_PER_RING, sphereSpin = SPHERE_SPIN_SPEED,
            spAnchor = SP_ANCHOR, spOffset = SP_OFFSET_DIST, spOffsetUp = SP_OFFSET_UP,
            spTight = SP_TIGHT, spOrbit = SP_ORBIT, spOrbitSpeed = SP_ORBIT_SPEED,
        }))
    end)
end

pcall(function()
    if isfile and isfile(SAVE_KEY .. ".json") then
        local d = HttpService:JSONDecode(readfile(SAVE_KEY .. ".json"))
        if d.segments    then SEGMENTS = math.clamp(math.floor(d.segments), 1, 50) end
        if d.spacing     then SPACING  = math.clamp(math.floor(d.spacing), 2, 200) end
        if d.maxVel      then MAX_VEL  = math.clamp(d.maxVel, 0.1, 500) end
        if d.spinSpeed   then SPIN_SPEED = math.clamp(d.spinSpeed, 0.1, 100) end
        if d.orientation then orientation = d.orientation end
        if d.rotated45 ~= nil then rotated45 = d.rotated45 end
        if d.partSpin ~= nil then partSpin = d.partSpin end
        if d.showPreview ~= nil then showPreview = d.showPreview end
        if d.bringKey then
            local ok, kc = pcall(function() return Enum.KeyCode[d.bringKey] end)
            if ok and kc then bringKey = kc end
        end
        if d.customGrid then customGrid = d.customGrid end
        if d.tornadoRings then TORNADO_RINGS = math.clamp(d.tornadoRings, 2, 30) end
        if d.tornadoPerRing then TORNADO_PER_RING = math.clamp(d.tornadoPerRing, 4, 40) end
        if d.tornadoHeight then TORNADO_HEIGHT = math.clamp(d.tornadoHeight, 10, 300) end
        if d.tornadoTopR then TORNADO_TOP_RADIUS = math.clamp(d.tornadoTopR, 5, 200) end
        if d.tornadoBotR then TORNADO_BOT_RADIUS = math.clamp(d.tornadoBotR, 1, 100) end
        if d.tornadoSpin then TORNADO_SPIN_SPEED = math.clamp(d.tornadoSpin, 0.5, 50) end
        if d.ringRadius then RING_RADIUS = math.clamp(d.ringRadius, 5, 200) end
        if d.ringPoints then RING_POINTS = math.clamp(d.ringPoints, 4, 60) end
        if d.ringSpin then RING_SPIN_SPEED = math.clamp(d.ringSpin, 0.5, 50) end
        if d.ringHeight then RING_HEIGHT = math.clamp(d.ringHeight, -50, 50) end
        if d.sphereRadius then SPHERE_RADIUS = math.clamp(d.sphereRadius, 5, 200) end
        if d.sphereRings then SPHERE_RINGS = math.clamp(d.sphereRings, 3, 20) end
        if d.spherePerRing then SPHERE_PER_RING = math.clamp(d.spherePerRing, 4, 30) end
        if d.sphereSpin then SPHERE_SPIN_SPEED = math.clamp(d.sphereSpin, 0, 20) end
        if d.spAnchor then SP_ANCHOR = d.spAnchor end
        if d.spOffset then SP_OFFSET_DIST = math.clamp(d.spOffset, -50, 100) end
        if d.spOffsetUp then SP_OFFSET_UP = math.clamp(d.spOffsetUp, -50, 50) end
        if d.spTight ~= nil then SP_TIGHT = d.spTight end
        if d.spOrbit ~= nil then SP_ORBIT = d.spOrbit end
        if d.spOrbitSpeed then SP_ORBIT_SPEED = math.clamp(d.spOrbitSpeed, 0, 20) end
        VORTEX_OFFSETS = buildVortexOffsets()
    end
end)

-- ============================================================
--  HELPERS
-- ============================================================
local function tween(obj, info, props)
    local t = TweenService:Create(obj, info, props); t:Play(); return t
end

local function create(class, props, children)
    local obj = Instance.new(class)
    for k, v in pairs(props or {}) do obj[k] = v end
    for _, c in ipairs(children or {}) do c.Parent = obj end
    return obj
end

local function addCorner(obj, r)
    local c = Instance.new("UICorner", obj); c.CornerRadius = UDim.new(0, r or 8); return c
end

local function addStroke(obj, color, thick)
    local s = Instance.new("UIStroke", obj)
    s.Color = color or T.border; s.Thickness = thick or 1
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
    return s
end

