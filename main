-- ============================================================
--  NETWORK RETENTION & CONTROLLER (FIX DROP & MEMORY LEAK)
-- ============================================================
if not getgenv().Network then
    getgenv().Network = {
        BaseParts = {},
        Velocity = Vector3.new(14.4626, 14.4626, 14.4626),
        Active = false
    }

    getgenv().Network.RetainPart = function(p)
        if p:IsA("BasePart") and p:IsDescendantOf(workspace) then
            getgenv().Network.BaseParts[p] = true
            p.CustomPhysicalProperties = PhysicalProperties.new(0, 0, 0, 0, 0)
            p.CanCollide = false
            p.AncestryChanged:Once(function(_, parent)
                if not parent then
                    getgenv().Network.BaseParts[p] = nil
                end
            end)
        end
    end

    RunService.Heartbeat:Connect(function()
        if not getgenv().Network.Active then return end
        pcall(function()
            sethiddenproperty(LocalPlayer, "SimulationRadius", math.huge)
        end)
        for p in pairs(getgenv().Network.BaseParts) do
            if p:IsDescendantOf(workspace) then
                p.Velocity = getgenv().Network.Velocity
            else
                getgenv().Network.BaseParts[p] = nil
            end
        end
    end)
end

local Network = getgenv().Network

