local layoutOrder = 0
local function nextOrder() layoutOrder = layoutOrder + 1; return layoutOrder end

-- ============================================================
--  COLLAPSIBLE ACCORDION COMPONENT (▼ / ▲)
-- ============================================================
local function createCollapsibleSection(title, defaultOpen)
    local isOpen = defaultOpen == true
    local sec = create("Frame", {
        Parent = content, BackgroundColor3 = T.card, BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
        LayoutOrder = nextOrder(), ClipsDescendants = true,
    })
    addCorner(sec, 10); addStroke(sec, T.border, 1)

    local headBtn = create("TextButton", {
        Parent = sec, BackgroundColor3 = T.cardHeader, BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 36), Text = "", AutoButtonColor = false,
    })
    addCorner(headBtn, 10)
    addStroke(headBtn, T.border, 1)

    create("TextLabel", {
        Parent = headBtn, BackgroundTransparency = 1,
        Position = UDim2.new(0, 12, 0, 0), Size = UDim2.new(1, -50, 1, 0),
        Font = Enum.Font.GothamBold, Text = title,
        TextColor3 = T.text, TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    local arrow = create("TextLabel", {
        Parent = headBtn, BackgroundTransparency = 1,
        Position = UDim2.new(1, -28, 0, 0), Size = UDim2.new(0, 20, 1, 0),
        Font = Enum.Font.GothamBold, Text = isOpen and "▲" or "▼",
        TextColor3 = T.accent, TextSize = 11,
    })

    local body = create("Frame", {
        Parent = sec, BackgroundTransparency = 1,
        Position = UDim2.new(0, 0, 0, 36), Size = UDim2.new(1, 0, 0, 0),
        AutomaticSize = Enum.AutomaticSize.Y, Visible = isOpen,
    })
    local bp = Instance.new("UIPadding", body)
    bp.PaddingTop = UDim.new(0, 8); bp.PaddingBottom = UDim.new(0, 10)
    bp.PaddingLeft = UDim.new(0, 12); bp.PaddingRight = UDim.new(0, 12)
    create("UIListLayout", {
        Parent = body, SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6),
    })

    headBtn.MouseEnter:Connect(function()
        tween(headBtn, ANIM_FAST, { BackgroundColor3 = T.elevated })
    end)
    headBtn.MouseLeave:Connect(function()
        tween(headBtn, ANIM_FAST, { BackgroundColor3 = T.cardHeader })
    end)

    headBtn.MouseButton1Click:Connect(function()
        isOpen = not isOpen
        arrow.Text = isOpen and "▲" or "▼"
        tween(arrow, ANIM_FAST, { TextColor3 = isOpen and T.accentHover or T.textDim })
        body.Visible = isOpen
    end)

    return body
end

-- ============================================================
--  COMPONENTS: TOGGLE, SLIDER, DROPDOWN, INPUT ROW
-- ============================================================
local function createToggle(parent, labelText, default, callback)
    local state = default == true
    local holder = create("Frame", {
        Parent = parent, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 34),
    })
    create("TextLabel", {
        Parent = holder, BackgroundTransparency = 1,
        Size = UDim2.new(1, -60, 1, 0), Font = Enum.Font.GothamMedium,
        Text = labelText, TextColor3 = T.text, TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
    })
    local track = create("Frame", {
        Parent = holder, AnchorPoint = Vector2.new(1, 0.5),
        Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, 42, 0, 22),
        BackgroundColor3 = state and T.toggleOn or T.toggleOff,
    })
    addCorner(track, 11)
    local knob = create("Frame", {
        Parent = track, AnchorPoint = Vector2.new(0, 0.5),
        Position = state and UDim2.new(1, -20, 0.5, 0) or UDim2.new(0, 2, 0.5, 0),
        Size = UDim2.new(0, 18, 0, 18), BackgroundColor3 = Color3.new(1, 1, 1),
    })
    addCorner(knob, 9)

    local btn = create("TextButton", {
        Parent = holder, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 1, 0),
        Text = "", ZIndex = 5, AutoButtonColor = false,
    })

    local function paint(on, animate)
        local tp = { BackgroundColor3 = on and T.toggleOn or T.toggleOff }
        local kp = { Position = on and UDim2.new(1, -20, 0.5, 0) or UDim2.new(0, 2, 0.5, 0) }
        if animate then
            tween(track, ANIM_SPRING, tp); tween(knob, ANIM_BOUNCE, kp)
        else
            track.BackgroundColor3 = tp.BackgroundColor3; knob.Position = kp.Position
        end
    end

    btn.MouseButton1Click:Connect(function()
        state = not state
        paint(state, true)
        if callback then callback(state) end
    end)

    return {
        holder = holder,
        setState = function(v) v = v == true; if state ~= v then state = v; paint(state, true) end end,
        getState = function() return state end,
    }
end

local function createSlider(parent, labelText, min, max, default, step, callback)
    local value = math.clamp(default, min, max)
    local holder = create("Frame", {
        Parent = parent, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 44),
    })
    local label = create("TextLabel", {
        Parent = holder, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 16),
        Font = Enum.Font.GothamMedium,
        Text = labelText .. ": " .. tostring(value),
        TextColor3 = T.textDim, TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left,
    })
    local trackFrame = create("Frame", {
        Parent = holder, BackgroundColor3 = T.elevated,
        Position = UDim2.new(0, 0, 0, 22), Size = UDim2.new(1, 0, 0, 14),
    })
    addCorner(trackFrame, 7); addStroke(trackFrame, T.border, 1)

    local fill = create("Frame", {
        Parent = trackFrame, BackgroundColor3 = T.accent,
        Size = UDim2.new((value - min) / (max - min), 0, 1, 0),
    })
    addCorner(fill, 7)

    local knobS = create("Frame", {
        Parent = trackFrame, BackgroundColor3 = Color3.new(1, 1, 1),
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new((value - min) / (max - min), 0, 0.5, 0),
        Size = UDim2.new(0, 14, 0, 14),
    })
    addCorner(knobS, 7)

    local inputBtn = create("TextButton", {
        Parent = trackFrame, BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0), Text = "", ZIndex = 5, AutoButtonColor = false,
    })

    local dragging = false
    local function setVal(v)
        v = math.clamp(v, min, max)
        if step and step > 0 then
            v = math.floor(v / step + 0.5) * step
            v = math.clamp(v, min, max)
        end
        if math.abs(v - value) < 0.001 then return end
        value = v
        local pct = (value - min) / (max - min)
        fill.Size = UDim2.new(pct, 0, 1, 0)
        knobS.Position = UDim2.new(pct, 0, 0.5, 0)
        label.Text = labelText .. ": " .. (step >= 1 and tostring(math.floor(value)) or string.format("%.2f", value))
        if callback then callback(value) end
    end

    local function updateFromInput(inputObj)
        local absX = trackFrame.AbsolutePosition.X
        local absW = trackFrame.AbsoluteSize.X
        local rel = math.clamp((inputObj.Position.X - absX) / absW, 0, 1)
        setVal(min + rel * (max - min))
    end

    inputBtn.MouseButton1Down:Connect(function() dragging = true end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            updateFromInput(input)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if dragging then dragging = false; updateFromInput(input); saveConfig() end
        end
    end)

    return {
        holder = holder, getValue = function() return value end,
        setValue = function(v) setVal(v) end,
    }
end

local function createDropdown(parent, labelText, options, defaultValue, callback)
    local holder = create("Frame", {
        Parent = parent, BackgroundTransparency = 1, Size = UDim2.new(1, 0, 0, 30),
    })
    create("TextLabel", {
        Parent = holder, BackgroundTransparency = 1,
        Size = UDim2.new(0.45, 0, 1, 0), Font = Enum.Font.GothamMedium,
        Text = labelText, TextColor3 = T.textDim, TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
    })
    local btn = create("TextButton", {
        Parent = holder, BackgroundColor3 = T.elevated, BorderSizePixel = 0,
        AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
        Size = UDim2.new(0.5, 0, 0, 26), Font = Enum.Font.GothamMedium,
        Text = defaultValue, TextColor3 = T.text, TextSize = 12, AutoButtonColor = false,
    })
    addCorner(btn, 6); addStroke(btn, T.border, 1)

    local currentVal = defaultValue
    btn.MouseButton1Click:Connect(function()
        local idx = 1
        for i, opt in ipairs(options) do
            if opt == currentVal then idx = i; break end
        end
        idx = idx % #options + 1
        currentVal = options[idx]
        btn.Text = currentVal
        if callback then callback(currentVal) end
    end)
    return { holder = holder, getValue = function() return currentVal end }
end

local function createInputRow(sec, labelText, defaultVal, ord)
    local row = create("Frame", {
        Parent = sec, BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 30), LayoutOrder = ord,
    })
    create("TextLabel", {
        Parent = row, BackgroundTransparency = 1,
        Size = UDim2.new(0.55, 0, 1, 0), Font = Enum.Font.GothamMedium,
        Text = labelText, TextColor3 = T.textDim, TextSize = 12,
        TextXAlignment = Enum.TextXAlignment.Left,
    })
    local box = create("TextBox", {
        Parent = row, BackgroundColor3 = T.elevated, BorderSizePixel = 0,
        AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0),
        Size = UDim2.new(0.4, 0, 0, 26), Font = Enum.Font.GothamMedium,
        Text = tostring(defaultVal), TextColor3 = T.text, TextSize = 12,
        ClearTextOnFocus = false,
    })
    addCorner(box, 6); addStroke(box, T.border, 1)
    return box
end

local function createActionBtn(sec, text, color, ord)
    local btn = create("TextButton", {
        Parent = sec, BackgroundColor3 = color, BorderSizePixel = 0,
        Size = UDim2.new(1, 0, 0, 34), Font = Enum.Font.GothamBold,
        Text = text, TextColor3 = T.text, TextSize = 12, LayoutOrder = ord,
        AutoButtonColor = false,
    })
    addCorner(btn, 8)
    btn.MouseEnter:Connect(function()
        tween(btn, ANIM_FAST, { BackgroundColor3 = Color3.new(
            math.min(1, color.R + 0.08), math.min(1, color.G + 0.08), math.min(1, color.B + 0.08)) })
    end)
    btn.MouseLeave:Connect(function()
        tween(btn, ANIM_FAST, { BackgroundColor3 = color })
    end)
    return btn
end

-- ============================================================
--  ENGINE LOGIC
-- ============================================================
local blackHoleActive = false
local followPlayer    = false
local followMouse     = false
local startMode, stopMode, restartMode
local rebuildDrawGrid
local allModeToggles = {}
local forcedParts, lockedParts = {}, {}
local claimedParts = {}
local suctionPoints = {}
local applySpinToLocked
local Folder, CenterPart = nil, nil
local anchorBasePos = nil
local modeRenderConn = nil

local function isFromPlayer(part)
    if not part or not part.Parent then return false end
    local model = part:FindFirstAncestorOfClass("Model")
    if model and Players:GetPlayerFromCharacter(model) then return true end
    local bp = {Head=1,Torso=1,HumanoidRootPart=1,UpperTorso=1,LowerTorso=1,
        ["Left Arm"]=1,["Right Arm"]=1,["Left Leg"]=1,["Right Leg"]=1,
        LeftUpperArm=1,RightUpperArm=1,LeftLowerArm=1,RightLowerArm=1,
        LeftUpperLeg=1,RightUpperLeg=1,LeftLowerLeg=1,RightLowerLeg=1,
        LeftHand=1,RightHand=1,LeftFoot=1,RightFoot=1,Handle=1}
    if bp[part.Name] and part.Parent and part.Parent:FindFirstChildOfClass("Humanoid") then return true end
    return false
end

local function getPlayerBasePos()
    local char = LocalPlayer.Character
    if not char then return nil end
    local b = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChild("UpperTorso")
    return b and b.Position
end

local function getPlayerLookVector()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if hrp then
        local lv = hrp.CFrame.LookVector
        local fl = Vector3.new(lv.X, 0, lv.Z)
        if fl.Magnitude > 0.01 then return fl.Unit end
    end
    return Vector3.new(0, 0, -1)
end

local function getMouseWorldPos()
    local mouseLoc = UserInputService:GetMouseLocation()
    local unitRay = Camera:ViewportPointToRay(mouseLoc.X, mouseLoc.Y)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local fl = {Folder, LocalPlayer.Character}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then table.insert(fl, plr.Character) end
    end
    params.FilterDescendantsInstances = fl
    local result = Workspace:Raycast(unitRay.Origin, unitRay.Direction * MOUSE_MAX_DIST, params)
    if result then return result.Position end
    return unitRay.Origin + unitRay.Direction * MOUSE_MAX_DIST
end

local function getBasePos()
    if followMouse then return getMouseWorldPos() or getPlayerBasePos()
    elseif followPlayer then return getPlayerBasePos()
    else return anchorBasePos or getPlayerBasePos() end
end

local function getActiveTrackCount()
    local n = 0
    for _ in pairs(forcedParts) do n = n + 1 end
    for _ in pairs(lockedParts) do n = n + 1 end
    return n
end

local function buildAxes(mode)
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    local look = hrp and hrp.CFrame.LookVector or Camera.CFrame.LookVector
    local fl = Vector3.new(look.X, 0, look.Z)
    if fl.Magnitude < 0.001 then fl = Vector3.new(0, 0, -1) end
    fl = fl.Unit
    local right = fl:Cross(Vector3.new(0, 1, 0)).Unit
    local up = mode == "horizontal" and fl or Vector3.new(0, 1, 0)
    if rotated45 then
        local a = math.rad(45) * TILT_SIGN
        local co, si = math.cos(a), math.sin(a)
        up = (up * co + right:Cross(up) * si).Unit
    end
    return right, up
end

local function gridToOffsets(g)
    if not g then return nil end
    local offs = {}
    local N = g.N; local center = math.ceil(N / 2)
    for r = 1, N do for c = 1, N do
        if g.cells[r] and g.cells[r][c] then
            table.insert(offs, Vector2.new((c - center) * SPACING, (center - r) * SPACING))
        end
    end end
    return offs
end

local function getActiveOffsets()
    if customGrid then
        local o = gridToOffsets(customGrid)
        if o and #o > 0 then return o end
    end
    return VORTEX_OFFSETS
end

local function nextPoint()
    local best, bc = nil, math.huge
    for _, pt in ipairs(suctionPoints) do
        if #pt.holders < bc then best, bc = pt, #pt.holders end
    end
    return best
end

local function detachFromPoint(data, part)
    if data and data.point then
        local i = table.find(data.point.holders, part)
        if i then table.remove(data.point.holders, i) end
    end
end

local function releasePart(part, data)
    if data then
        if data.align  and data.align.Parent  then data.align:Destroy()  end
        if data.orient and data.orient.Parent then data.orient:Destroy() end
        if data.att    and data.att.Parent    then data.att:Destroy()    end
    end
    detachFromPoint(data, part)
    claimedParts[part] = nil; lockedParts[part] = nil; forcedParts[part] = nil
    if part and part.Parent then
        part.CanCollide = true
        part.AssemblyLinearVelocity = Vector3.zero
        part.AssemblyAngularVelocity = Vector3.zero
        part.CustomPhysicalProperties = nil -- Trả lại trọng lực để rơi xuống
        pcall(function() part:SetNetworkOwner(nil) end)
    end
end

local function lockPart(part, data)
    data.state = "locked"
    part.AssemblyLinearVelocity = Vector3.new(0, 0.01, 0)
    if data.align and data.align.Parent then
        data.align.RigidityEnabled = true
        data.align.MaxVelocity = math.huge
    end
    forcedParts[part] = nil; lockedParts[part] = data
end

applySpinToLocked = function()
    for part, _ in pairs(lockedParts) do
        if part and part.Parent then
            if partSpin then
                part.AssemblyAngularVelocity = Vector3.new(0, SPIN_SPEED, 0)
            else
                part.AssemblyAngularVelocity = Vector3.zero
            end
        end
    end
end

local function ForcePart(v)
    if getActiveTrackCount() >= MAX_TRACK then return end
    if not v:IsA("BasePart") or v.Anchored or v.Name == "Handle" then return end
    if Folder and v:IsDescendantOf(Folder) then return end
    if v:IsDescendantOf(LocalPlayer.Character or Folder) then return end
    if isFromPlayer(v) or forcedParts[v] or claimedParts[v] or lockedParts[v] then return end
    local basePos = anchorBasePos or getPlayerBasePos()
    if not basePos or (v.Position - basePos).Magnitude > SCAN_RADIUS then return end
    local pt = nextPoint(); if not pt then return end

    for _, x in ipairs(v:GetChildren()) do
        if x:IsA("BodyMover") or x:IsA("RocketPropulsion") then x:Destroy() end
    end
    for _, n in ipairs({"Attachment","AlignPosition","Torque","WeldConstraint"}) do
        local c = v:FindFirstChild(n); if c then c:Destroy() end
    end

    -- Fling Bypass: Đẩy người chơi khác khỏi part để cướp Network Owner
    if autoFlingBypass then
        v.AssemblyLinearVelocity = Vector3.new(0, 99999, 0)
        v.AssemblyAngularVelocity = Vector3.new(99999, 99999, 99999)
    end

    pcall(function() v:SetNetworkOwner(LocalPlayer) end)
    v.CanCollide = false
    Network.RetainPart(v)

    local att = Instance.new("Attachment", v)
    local ap = Instance.new("AlignPosition", v)
    ap.MaxForce = math.huge; ap.MaxVelocity = MAX_VEL; ap.Responsiveness = 200
    ap.Attachment0 = att; ap.Attachment1 = pt.attachment; ap.ApplyAtCenterOfMass = true
    table.insert(pt.holders, v); claimedParts[v] = true
    forcedParts[v] = {align=ap, att=att, point=pt, state="flying", orient=nil}
end

local function scanNearbyParts()
    local basePos = anchorBasePos or getPlayerBasePos()
    if not basePos then return end
    local params = OverlapParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local fl = {Folder, LocalPlayer.Character}
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer and plr.Character then table.insert(fl, plr.Character) end
    end
    params.FilterDescendantsInstances = fl
    for _, v in ipairs(Workspace:GetPartBoundsInRadius(basePos, SCAN_RADIUS, params)) do
        if not v.Anchored and not forcedParts[v] and not claimedParts[v]
            and not lockedParts[v] and not isFromPlayer(v) then
            ForcePart(v)
        end
    end
end

local function tickFlying()
    for part, data in pairs(forcedParts) do
        if not part.Parent or isFromPlayer(part) then releasePart(part, data); continue end
        local delta = data.point.part.Position - part.Position
        if delta.Magnitude <= ARRIVE_DIST then
            lockPart(part, data)
        else
            part.AssemblyLinearVelocity = delta.Unit * MAX_VEL
            part.AssemblyAngularVelocity = Vector3.zero
        end
    end
end

local function tickHold()
    for part, data in pairs(lockedParts) do
        if not part.Parent or isFromPlayer(part) then
            releasePart(part, data)
        else
            part.AssemblyLinearVelocity = Vector3.new(0, 0.01, 0)
            if partSpin then
                part.AssemblyAngularVelocity = Vector3.new(0, SPIN_SPEED, 0)
            else
                part.AssemblyAngularVelocity = Vector3.zero
            end
        end
    end
end

-- ============================================================
--  CLEAN BLOCK (SỬA ĐỂ PART TỰ RƠI XUỐNG ĐẤT)
-- ============================================================
local function cleanBlock()
    if modeRenderConn then modeRenderConn:Disconnect(); modeRenderConn = nil end
    pcall(function() LocalPlayer.ReplicationFocus = nil end)
    Network.Active = false

    for part, data in pairs(forcedParts) do releasePart(part, data) end
    for part, data in pairs(lockedParts) do releasePart(part, data) end

    -- Khôi phục trạng thái trọng lực và xoá khỏi Network loop
    for part in pairs(Network.BaseParts) do
        if part and part.Parent then
            part.AssemblyLinearVelocity = Vector3.zero
            part.AssemblyAngularVelocity = Vector3.zero
            part.CustomPhysicalProperties = nil
            part.CanCollide = true
        end
    end
    table.clear(Network.BaseParts)

    forcedParts, claimedParts, lockedParts = {}, {}, {}
    if Folder and Folder.Parent then Folder:Destroy() end
    Folder, CenterPart, suctionPoints, anchorBasePos = nil, nil, {}, nil
end

-- ============================================================
--  BUILD SUCTION POINTS
-- ============================================================
local function createSuctionPart(parent, pos)
    local p = Instance.new("Part", parent)
    p.Name = "SP"; p.Anchored = true; p.CanCollide = false
    p.Transparency = showPreview and 0.15 or 1
    p.Size = MARKER_SIZE; p.Color = MARKER_COLOR
    p.Material = MARKER_MAT; p.CastShadow = false
    p.CFrame = CFrame.new(pos)
    local att = Instance.new("Attachment", p)
    return p, att
end

local function buildVortexPoints(basePos)
    local right, up = buildAxes(orientation)
    for i, off in ipairs(getActiveOffsets()) do
        local pos = basePos + right * off.X + up * off.Y
        local p, att = createSuctionPart(Folder, pos)
        p.Name = "SP" .. i
        table.insert(suctionPoints, {part=p, attachment=att, offset2D=off, holders={}, mode="vortex"})
    end
end

local function buildTornadoPoints(basePos)
    for ring = 1, TORNADO_RINGS do
        local t = (ring - 1) / (TORNADO_RINGS - 1)
        local y = t * TORNADO_HEIGHT
        local r = TORNADO_BOT_RADIUS + t * (TORNADO_TOP_RADIUS - TORNADO_BOT_RADIUS)
        for j = 1, TORNADO_PER_RING do
            local angle = (j - 1) / TORNADO_PER_RING * math.pi * 2
            local pos = basePos + Vector3.new(math.cos(angle) * r, y, math.sin(angle) * r)
            local p, att = createSuctionPart(Folder, pos)
            table.insert(suctionPoints, {
                part=p, attachment=att, holders={}, mode="tornado",
                ringIdx=ring, pointIdx=j, baseAngle=angle,
                ringT=t, ringR=r, ringY=y,
            })
        end
    end
end

local function buildRingPoints(basePos)
    for j = 1, RING_POINTS do
        local angle = (j - 1) / RING_POINTS * math.pi * 2
        local pos = basePos + Vector3.new(math.cos(angle) * RING_RADIUS, RING_HEIGHT, math.sin(angle) * RING_RADIUS)
        local p, att = createSuctionPart(Folder, pos)
        table.insert(suctionPoints, {
            part=p, attachment=att, holders={}, mode="ring",
            pointIdx=j, baseAngle=angle,
        })
    end
end

local function buildSpherePoints(basePos)
    for ring = 1, SPHERE_RINGS do
        local lat = -math.pi/2 + (ring / (SPHERE_RINGS + 1)) * math.pi
        local y = math.sin(lat) * SPHERE_RADIUS
        local ringR = math.cos(lat) * SPHERE_RADIUS
        for j = 1, SPHERE_PER_RING do
            local lon = (j - 1) / SPHERE_PER_RING * math.pi * 2
            local pos = basePos + Vector3.new(math.cos(lon) * ringR, y, math.sin(lon) * ringR)
            local p, att = createSuctionPart(Folder, pos)
            table.insert(suctionPoints, {
                part=p, attachment=att, holders={}, mode="sphere",
                ringIdx=ring, pointIdx=j, baseLon=lon, lat=lat,
                ringR=ringR, ringY=y,
            })
        end
    end
end

local function computeSinglePointPos(basePos)
    local pos = basePos
    if SP_ANCHOR == "front" then
        local look = getPlayerLookVector()
        pos = basePos + look * SP_OFFSET_DIST + Vector3.new(0, SP_OFFSET_UP, 0)
    elseif SP_ANCHOR == "head" then
        pos = basePos + Vector3.new(0, SP_OFFSET_DIST + SP_OFFSET_UP, 0)
    elseif SP_ANCHOR == "feet" then
        pos = basePos + Vector3.new(0, -SP_OFFSET_DIST + SP_OFFSET_UP, 0)
    elseif SP_ANCHOR == "camera" then
        local cf = Camera.CFrame
        pos = cf.Position + cf.LookVector * SP_OFFSET_DIST + Vector3.new(0, SP_OFFSET_UP, 0)
    elseif SP_ANCHOR == "mouse" then
        pos = getMouseWorldPos() + Vector3.new(0, SP_OFFSET_UP, 0)
    end
    return pos
end

local function buildSinglePoint(basePos)
    local pos = computeSinglePointPos(basePos)
    local p, att = createSuctionPart(Folder, pos)
    p.Name = "SP_Single"
    table.insert(suctionPoints, {
        part=p, attachment=att, holders={}, mode="single", baseAngle=0,
    })
end

-- ============================================================
--  DYNAMIC REPOSITIONING
-- ============================================================
local function repositionVortex(basePos)
    if not Folder or not CenterPart then return end
    local right, up = buildAxes(orientation)
    CenterPart.CFrame = CFrame.new(basePos)
    for _, pt in ipairs(suctionPoints) do
        local o = pt.offset2D
        pt.part.CFrame = CFrame.new(basePos + right * o.X + up * o.Y)
    end
end

local tornadoTime = 0
local function repositionTornado(basePos, dt)
    if not Folder or not CenterPart then return end
    CenterPart.CFrame = CFrame.new(basePos)
    tornadoTime = tornadoTime + dt * TORNADO_SPIN_SPEED
    for _, pt in ipairs(suctionPoints) do
        local t = pt.ringT
        local r = TORNADO_BOT_RADIUS + t * (TORNADO_TOP_RADIUS - TORNADO_BOT_RADIUS)
        local y = t * TORNADO_HEIGHT
        local angle = pt.baseAngle + tornadoTime * (1 + (1 - t) * 2)
        pt.part.CFrame = CFrame.new(basePos + Vector3.new(math.cos(angle) * r, y, math.sin(angle) * r))
    end
end

local ringTime = 0
local function repositionRing(basePos, dt)
    if not Folder or not CenterPart then return end
    CenterPart.CFrame = CFrame.new(basePos)
    ringTime = ringTime + dt * RING_SPIN_SPEED
    for _, pt in ipairs(suctionPoints) do
        local angle = pt.baseAngle + ringTime
        pt.part.CFrame = CFrame.new(basePos + Vector3.new(
            math.cos(angle) * RING_RADIUS, RING_HEIGHT, math.sin(angle) * RING_RADIUS))
    end
end

local sphereTime = 0
local function repositionSphere(basePos, dt)
    if not Folder or not CenterPart then return end
    CenterPart.CFrame = CFrame.new(basePos)
    sphereTime = sphereTime + dt * SPHERE_SPIN_SPEED
    for _, pt in ipairs(suctionPoints) do
        local lon = pt.baseLon + sphereTime
        local ringR = math.cos(pt.lat) * SPHERE_RADIUS
        local y = math.sin(pt.lat) * SPHERE_RADIUS
        pt.part.CFrame = CFrame.new(basePos + Vector3.new(
            math.cos(lon) * ringR, y, math.sin(lon) * ringR))
    end
end

local singleOrbitTime = 0
local function repositionSingle(basePos, dt)
    if not Folder or not CenterPart then return end
    CenterPart.CFrame = CFrame.new(basePos)
    local pos = computeSinglePointPos(basePos)
    if SP_ORBIT then
        singleOrbitTime = singleOrbitTime + dt * SP_ORBIT_SPEED
        local r = math.abs(SP_OFFSET_DIST)
        pos = basePos + Vector3.new(math.cos(singleOrbitTime) * r, SP_OFFSET_UP, math.sin(singleOrbitTime) * r)
    end
    for _, pt in ipairs(suctionPoints) do
        pt.part.CFrame = CFrame.new(pos)
    end
end

-- ============================================================
--  START / STOP CONTROLLER
-- ============================================================
local function buildFolder(basePos)
    Folder = Instance.new("Folder", Workspace); Folder.Name = "BringFolder"
    CenterPart = Instance.new("Part", Folder)
    CenterPart.Name = "Center"; CenterPart.Anchored = true; CenterPart.CanCollide = false
    CenterPart.Transparency = 1; CenterPart.Size = Vector3.new(1, 1, 1)
    CenterPart.CFrame = CFrame.new(basePos)
    pcall(function() LocalPlayer.ReplicationFocus = CenterPart end)
end

local function startLoops()
    task.spawn(function() while blackHoleActive do pcall(scanNearbyParts); task.wait(SCAN_INTERVAL) end end)
    task.spawn(function() while blackHoleActive do pcall(tickFlying); task.wait(FLY_TICK) end end)
    task.spawn(function() while blackHoleActive do pcall(tickHold); task.wait(HOLD_TICK) end end)
end

startMode = function(mode)
    if blackHoleActive then stopMode() end
    activeMode = mode
    blackHoleActive = true
    Network.Active = true

    local basePos = getBasePos()
    if not basePos then
        blackHoleActive = false; activeMode = "none"; Network.Active = false
        return false
    end
    anchorBasePos = basePos

    buildFolder(basePos)
    suctionPoints = {}
    tornadoTime = 0; ringTime = 0; sphereTime = 0; singleOrbitTime = 0

    if mode == "vortex" then buildVortexPoints(basePos)
    elseif mode == "tornado" then buildTornadoPoints(basePos)
    elseif mode == "ring" then buildRingPoints(basePos)
    elseif mode == "sphere" then buildSpherePoints(basePos)
    elseif mode == "single" then buildSinglePoint(basePos)
    end

    scanNearbyParts()
    startLoops()

    modeRenderConn = RunService.RenderStepped:Connect(function(dt)
        if not blackHoleActive then return end
        local bp = getBasePos()
        if not bp then return end
        anchorBasePos = bp

        if mode == "vortex" then
            if followPlayer or followMouse then pcall(repositionVortex, bp) end
        elseif mode == "tornado" then pcall(repositionTornado, bp, dt)
        elseif mode == "ring" then pcall(repositionRing, bp, dt)
        elseif mode == "sphere" then pcall(repositionSphere, bp, dt)
        elseif mode == "single" then pcall(repositionSingle, bp, dt)
        end
    end)

    saveConfig()
    return true
end

stopMode = function()
    if not blackHoleActive then return end
    blackHoleActive = false
    activeMode = "none"
    cleanBlock()
    saveConfig()
end

restartMode = function()
    local was = activeMode
    if was == "none" then return end
    stopMode()
    task.wait(0.05)
    startMode(was)
end

-- ============================================================
--  SECTIONS & UI BUILDING
-- ============================================================

-- 1. MODE SELECT (Mở mặc định)
local sec1 = createCollapsibleSection("⚡ MODE SELECT", true)
local function disableAllModes(except)
    for name, tog in pairs(allModeToggles) do
        if name ~= except then tog.setState(false) end
    end
end

allModeToggles["vortex"] = createToggle(sec1, "🌀 Vortex (Hình vẽ)", false, function(on)
    disableAllModes("vortex")
    if on then startMode("vortex") else stopMode() end
end)
allModeToggles["tornado"] = createToggle(sec1, "🌪️ Lốc Xoáy", false, function(on)
    disableAllModes("tornado")
    if on then startMode("tornado") else stopMode() end
end)
allModeToggles["ring"] = createToggle(sec1, "💫 Ring", false, function(on)
    disableAllModes("ring")
    if on then startMode("ring") else stopMode() end
end)
allModeToggles["sphere"] = createToggle(sec1, "🔵 Hình Cầu", false, function(on)
    disableAllModes("sphere")
    if on then startMode("sphere") else stopMode() end
end)
allModeToggles["single"] = createToggle(sec1, "🎯 Single Point (1 điểm)", false, function(on)
    disableAllModes("single")
    if on then startMode("single") else stopMode() end
end)
createToggle(sec1, "💥 Fling cướp Part bị dẫm", autoFlingBypass, function(on)
    autoFlingBypass = on
end)

-- 2. FOLLOW (Mở mặc định)
local sec_follow = createCollapsibleSection("📍 FOLLOW TARGET", true)
local followToggle, mouseToggle
followToggle = createToggle(sec_follow, "Đi theo Player", false, function(on)
    followPlayer = on
    if on and followMouse then followMouse = false; mouseToggle.setState(false) end
    saveConfig()
end)
mouseToggle = createToggle(sec_follow, "Đi theo Chuột", false, function(on)
    followMouse = on
    if on and followPlayer then followPlayer = false; followToggle.setState(false) end
    saveConfig()
end)

-- 3. VORTEX PARAMS (Mở mặc định)
local sec_vortex = createCollapsibleSection("🌀 VORTEX PARAMS", true)
local segBox   = createInputRow(sec_vortex, "Điểm (1–50)",       SEGMENTS,   1)
local spaceBox = createInputRow(sec_vortex, "Khoảng cách",       SPACING,    2)
local velBox   = createInputRow(sec_vortex, "Vận tốc (stud/s)",  MAX_VEL,    3)
local spinBox  = createInputRow(sec_vortex, "Tốc độ xoay Part",  SPIN_SPEED, 4)

createToggle(sec_vortex, "Xoay Part tại điểm hút", partSpin, function(on)
    partSpin = on; saveConfig()
    if applySpinToLocked then applySpinToLocked() end
end)

createToggle(sec_vortex, "Hiện Preview", showPreview, function(on)
    showPreview = on; saveConfig()
    for _, pt in ipairs(suctionPoints) do
        if pt.part and pt.part.Parent then pt.part.Transparency = on and 0.15 or 1 end
    end
