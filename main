-- ============================================================
--  ĐỦ 100% 12 HÌNH VẼ PRESETS THEO BẢN GỐC
-- ============================================================
local function generatePreset(name, N)
    local grid = {}
    for r = 1, N do grid[r] = {}; for c = 1, N do grid[r][c] = false end end
    local center = math.ceil(N / 2)
    local radius = (N - 1) / 2

    if name == "Vortex" then
        local S = SPACING
        local segs = math.floor((N - 1) / 2)
        for arm = 1, 4 do
            local baseAngle = (arm - 1) * (math.pi / 2)
            for i = 1, segs do
                local dist = i * S
                local angle = baseAngle + (i * 0.12)
                local off = Vector2.new(math.cos(angle) * dist, math.sin(angle) * dist)
                local col = math.floor(off.X / S + 0.5) + center
                local row = center - math.floor(off.Y / S + 0.5)
                if row >= 1 and row <= N and col >= 1 and col <= N then grid[row][col] = true end
            end
        end
    elseif name == "Circle" then
        for r = 1, N do for c = 1, N do
            if math.sqrt((c-center)^2 + (r-center)^2) <= radius + 0.3 then grid[r][c] = true end
        end end
    elseif name == "Ring" then
        for r = 1, N do for c = 1, N do
            local d = math.sqrt((c-center)^2 + (r-center)^2)
            if d <= radius + 0.3 and d >= radius - 1.5 then grid[r][c] = true end
        end end
    elseif name == "Square" then
        for r = 1, N do for c = 1, N do grid[r][c] = true end end
    elseif name == "Frame" then
        for r = 1, N do for c = 1, N do
            if r==1 or r==N or c==1 or c==N then grid[r][c] = true end
        end end
    elseif name == "Diamond" then
        for r = 1, N do for c = 1, N do
            if math.abs(r-center)+math.abs(c-center) <= radius then grid[r][c] = true end
        end end
    elseif name == "Cross" then
        for i = 1, N do grid[center][i] = true; grid[i][center] = true end
    elseif name == "X" then
        for i = 1, N do grid[i][i] = true; grid[i][N-i+1] = true end
    elseif name == "Star" then
        for i = 1, N do
            grid[center][i] = true; grid[i][center] = true
            grid[i][i] = true; grid[i][N-i+1] = true
        end
    elseif name == "Heart" then
        for r = 1, N do for c = 1, N do
            local x = (c-center)/radius; local y = -(r-center)/radius
            if (x*x+y*y-1)^3 - x*x*y*y*y <= 0 then grid[r][c] = true end
        end end
    elseif name == "Arrow" then
        for i = 1, N do grid[i][center] = true end
        for i = 1, math.ceil(radius) do
            if center-i >= 1 then grid[i][center-i] = true end
            if center+i <= N then grid[i][center+i] = true end
        end
    elseif name == "Triangle" then
        for r = 1, N do
            local halfW = math.floor((r-1)*radius/(N-1))
            for c = center-halfW, center+halfW do
                if c >= 1 and c <= N then grid[r][c] = true end
            end
        end
    end
    return grid
end

local presetNames = {"Vortex","Circle","Ring","Square","Frame","Diamond","Cross","X","Star","Heart","Arrow","Triangle"}
local presetIcons = {"🌀","●","◎","■","□","◆","✚","✕","✦","♥","▲","▲"}

local drawGrid, drawN, cellBtns = {}, 0, {}
local isMouseDown, paintMode = false, nil

local function refreshCellVisual(btn, on)
    tween(btn, ANIM_FAST, { BackgroundColor3 = on and T.cellOn or T.cellOff })
end

rebuildDrawGrid = function()
    for _, b in ipairs(cellBtns) do b:Destroy() end
    cellBtns = {}; drawGrid = {}; drawN = 2 * SEGMENTS + 1

    DrawTitle.Text = string.format("🎨 Vẽ hình • %d × %d", drawN, drawN)

    local frameSize = 332
    local pad = 1
    local cell = math.floor((frameSize - pad * (drawN - 1) - 8) / drawN)
    cell = math.max(2, math.min(36, cell))
    GridLayout.CellSize = UDim2.new(0, cell, 0, cell)
    GridLayout.CellPadding = UDim2.new(0, pad, 0, pad)
    local realSize = cell * drawN + pad * (drawN - 1) + 8
    GridFrame.Size = UDim2.new(0, realSize, 0, realSize)

    for r = 1, drawN do drawGrid[r] = {}; for c = 1, drawN do drawGrid[r][c] = false end end

    local center = math.ceil(drawN / 2)
    if customGrid and customGrid.N == drawN then
        for r = 1, drawN do for c = 1, drawN do
            if customGrid.cells[r] and customGrid.cells[r][c] then drawGrid[r][c] = true end
        end end
    else
        for _, off in ipairs(VORTEX_OFFSETS) do
            local col = math.floor(off.X / SPACING + 0.5) + center
            local row = center - math.floor(off.Y / SPACING + 0.5)
            if row >= 1 and row <= drawN and col >= 1 and col <= drawN then drawGrid[row][col] = true end
        end
    end

    local ord = 1
    for r = 1, drawN do for c = 1, drawN do
        local btn = create("TextButton", {
            Parent = GridFrame, BorderSizePixel = 0, Text = "",
            AutoButtonColor = false, LayoutOrder = ord, ZIndex = 22,
            BackgroundColor3 = drawGrid[r][c] and T.cellOn or T.cellOff,
        })
        addCorner(btn, math.max(1, math.floor(cell / 6)))
        ord = ord + 1
        local rr, cc = r, c
        btn.MouseButton1Down:Connect(function()
            isMouseDown = true
            paintMode = not drawGrid[rr][cc]
            drawGrid[rr][cc] = paintMode
            refreshCellVisual(btn, paintMode)
        end)
        btn.MouseEnter:Connect(function()
            if isMouseDown and paintMode ~= nil then
                drawGrid[rr][cc] = paintMode
                refreshCellVisual(btn, paintMode)
            end
        end)
        table.insert(cellBtns, btn)
    end end
end

local function applyPresetToGrid(pg)
    local idx = 1
    for r = 1, drawN do for c = 1, drawN do
        local on = pg[r] and pg[r][c] or false
        drawGrid[r][c] = on
        if cellBtns[idx] then refreshCellVisual(cellBtns[idx], on) end
        idx = idx + 1
    end end
end

for i, name in ipairs(presetNames) do
    local pb = create("TextButton", {
        Parent = presetScroll, BackgroundColor3 = T.elevated,
        BorderSizePixel = 0, Size = UDim2.new(0, 60, 0, 44),
        Font = Enum.Font.GothamBold, Text = "",
        LayoutOrder = i, ZIndex = 23, AutoButtonColor = false,
    })
    addCorner(pb, 8)
    create("TextLabel", {
        Parent = pb, BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 0, 24), Font = Enum.Font.GothamBold,
        Text = presetIcons[i] or "?", TextColor3 = T.accent,
        TextSize = 16, ZIndex = 24,
    })
    create("TextLabel", {
        Parent = pb, BackgroundTransparency = 1,
        Position = UDim2.new(0, 0, 0, 24), Size = UDim2.new(1, 0, 0, 18),
        Font = Enum.Font.Gotham, Text = name,
        TextColor3 = T.textDim, TextSize = 9, ZIndex = 24,
    })
    pb.MouseEnter:Connect(function() tween(pb, ANIM_FAST, { BackgroundColor3 = T.accent }) end)
    pb.MouseLeave:Connect(function() tween(pb, ANIM_FAST, { BackgroundColor3 = T.elevated }) end)
    pb.MouseButton1Click:Connect(function()
        if drawN > 0 then applyPresetToGrid(generatePreset(name, drawN)) end
    end)
end

-- ============================================================
--  INPUT BOX EVENTS
-- ============================================================
segBox.FocusLost:Connect(function()
    local n = tonumber(segBox.Text)
    if n and n >= 1 and n <= 50 then
        local v = math.floor(n)
        if v ~= SEGMENTS then
            SEGMENTS = v
            VORTEX_OFFSETS = buildVortexOffsets()
            if customGrid and customGrid.N ~= (2*SEGMENTS+1) then customGrid = nil end
            if DrawPanel.Visible then rebuildDrawGrid() end
            if activeMode == "vortex" and blackHoleActive then restartMode() end
            saveConfig()
        end
    end
    segBox.Text = tostring(SEGMENTS)
end)

spaceBox.FocusLost:Connect(function()
    local n = tonumber(spaceBox.Text)
    if n and n >= 2 and n <= 200 then
        local v = math.floor(n)
        if v ~= SPACING then
            SPACING = v
            VORTEX_OFFSETS = buildVortexOffsets()
            if activeMode == "vortex" and blackHoleActive then restartMode() end
            saveConfig()
        end
    end
    spaceBox.Text = tostring(SPACING)
end)

velBox.FocusLost:Connect(function()
    local n = tonumber(velBox.Text)
    if n and n >= 0.1 and n <= 500 then
        if n ~= MAX_VEL then
            MAX_VEL = n
            for _, d in pairs(forcedParts) do
                if d.align and d.align.Parent then d.align.MaxVelocity = MAX_VEL end
            end
            saveConfig()
        end
    end
    velBox.Text = tostring(MAX_VEL)
end)

spinBox.FocusLost:Connect(function()
    local n = tonumber(spinBox.Text)
    if n and n >= 0.1 and n <= 100 then
        if n ~= SPIN_SPEED then
            SPIN_SPEED = n
            if applySpinToLocked then applySpinToLocked() end
            saveConfig()
        end
    end
    spinBox.Text = tostring(SPIN_SPEED)
end)

-- ============================================================
--  HOTKEY & REBINDING
-- ============================================================
local isRebinding = false
keyBtn.MouseButton1Click:Connect(function()
    isRebinding = true
    tween(keyBtn, ANIM_FAST, { BackgroundColor3 = T.orange })
    keyBtn.Text = "Nhấn phím... (ESC = None)"
end)

UserInputService.InputBegan:Connect(function(input, gpe)
    if gpe or UserInputService:GetFocusedTextBox() then return end
    if isRebinding then
        if input.UserInputType == Enum.UserInputType.Keyboard then
            if input.KeyCode == Enum.KeyCode.Escape then
                bringKey = nil; keyBtn.Text = "Bind: None"
            else
                bringKey = input.KeyCode; keyBtn.Text = "Bind: " .. bringKey.Name
            end
            tween(keyBtn, ANIM_FAST, { BackgroundColor3 = T.elevated })
            isRebinding = false; saveConfig()
        end
        return
    end
    if bringKey and input.KeyCode == bringKey then
        if blackHoleActive then
            stopMode()
            for name, tog in pairs(allModeToggles) do tog.setState(false) end
        else
            local m = activeMode == "none" and "vortex" or activeMode
            disableAllModes(m)
            allModeToggles[m].setState(true)
            startMode(m)
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        isMouseDown = false; paintMode = nil
    end
end)

-- ============================================================
--  BUTTON TRIGGERS & MINIMIZE / REOPEN
-- ============================================================
drawBtn.MouseButton1Click:Connect(function()
    pcall(rebuildDrawGrid)
    DrawPanel.Visible = true
    DrawPanel.Position = UDim2.new(0.5, -210, 0.5, -310)
    tween(DrawPanel, ANIM_SPRING, { Position = UDim2.new(0.5, -210, 0.5, -290) })
end)

drawCloseBtn.MouseButton1Click:Connect(function() DrawPanel.Visible = false end)
cancelBtn.MouseButton1Click:Connect(function() DrawPanel.Visible = false end)

clearBtn.MouseButton1Click:Connect(function()
    for r = 1, drawN do for c = 1, drawN do drawGrid[r][c] = false end end
    local idx = 1
    for r = 1, drawN do for c = 1, drawN do
        if cellBtns[idx] then refreshCellVisual(cellBtns[idx], false) end
        idx = idx + 1
    end end
end)

doneBtn.MouseButton1Click:Connect(function()
    local cnt = 0
    for r = 1, drawN do for c = 1, drawN do if drawGrid[r][c] then cnt = cnt + 1 end end end
    if cnt == 0 then customGrid = nil
    else
        local cells = {}
        for r = 1, drawN do cells[r] = {}; for c = 1, drawN do cells[r][c] = drawGrid[r][c] end end
        customGrid = {N = drawN, cells = cells}
    end
    DrawPanel.Visible = false; saveConfig()
    if activeMode == "vortex" and blackHoleActive then restartMode() end
end)

local reopenBtn = create("TextButton", {
    Parent = Gui, BackgroundColor3 = T.accent, BorderSizePixel = 0,
    Position = UDim2.new(0, 16, 0.5, -20), Size = UDim2.new(0, 44, 0, 44),
